
/**
* Campaign entity
* @author Eva Maciejko
*/
entity PdiCampaign {
	organizationNum Long,
    organizationName String,
    project String,
    leaderNum String,
    leaderEmail String,
    dueDate LocalDate,
    orderTypeNum Integer,
    blocked Boolean,
    terminationDate LocalDate
}

/**
* Group entity
* @author Eva Maciejko
*/
entity PdiGroup {
	number Long,
    name String,
    leaderNum String
}

/**
* Seller entity
* @author Eva Maciejko
*/
entity Seller {
	number Long,
    name String    
}

/**
* WebUser entity
* Represents the web user accessing the application
* @author Eva Maciejko
*/
entity WebUser {
	username String,
    password String,
    firstName String,
    lastName String,
    language String,
    disabled Boolean
}

enum RoleEnum {
    BUYER, SELLER, LEAD, ADMIN
}

entity Role {
	name RoleEnum
}

enum OrderStatusEnum {
	PAID,
    ERROR
}

entity OrderHeader {
	orderNumber String,
    buyerName String,
    buyerPhone String,
    buyerNote String,
    buyerLanguage String,
    orderStatus OrderStatusEnum,
    confirmationNumber String
}

entity OrderItem {
	orderNumber String,
    productNumber String,
    quantity Integer,
    unitPrice BigDecimal    
}

entity PdiProduct {
	productNumber String,        
    nameFr String,
    nameEn String,
    descriptionFr String,
    descriptionEn String,
    weight String    
}

entity PdiCategory {
	number Long,
    descriptionFr String,
    descriptionEn String,
    unitPrice BigDecimal
}

entity OrderType {
	number Long    
}

relationship OneToOne {
	Seller{me} to WebUser,
    Seller{buyer} to WebUser,
    OrderItem{product} to PdiProduct
}

relationship ManyToMany {
	WebUser{name} to Role{webUser},
    OrderType{productNumber} to PdiProduct{number}
}

relationship OneToMany {
	PdiCampaign to PdiGroup{campaign},
	PdiGroup to Seller{group},
    Seller to OrderHeader{seller},
    OrderHeader to OrderItem{header},
    PdiCategory to PdiProduct{category},    
    OrderType{pdiProducts required} to PdiGroup
}

// Use Data Transfer Objects (DTO)
dto * with mapstruct

// Set service options to all except few
service all with serviceImpl except Role
