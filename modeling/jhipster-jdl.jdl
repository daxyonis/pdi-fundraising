
/**
* Campaign entity
* @author Eva Maciejko
*/
entity Campaign {
	organizationNumber Long,
    organizationName String,
    project String,
    dueDate LocalDate,
    orderType Integer,
    blocked Boolean
}

/**
* Group entity
* @author Eva Maciejko
*/
entity Group {
	number Long,
    name String,
    leader String    
}

/**
* Seller entity
* @author Eva Maciejko
*/
entity Seller {
	number Long,
    name String    
}

/**
* WebUser entity
* Represents the web user accessing the application
* @author Eva Maciejko
*/
entity WebUser {
	username String,
    password String,
    firstName String,
    lastName String,
    language String,
    disabled Boolean
}

enum RoleEnum {
    BUYER, SELLER, LEAD, ADMIN
}

entity Role {
	name RoleEnum
}

enum OrderStatusEnum {
	PAID
}

entity OrderHeader {
	orderNumber String,
    buyerName String,
    buyerPhone String,
    buyerNote String,
    buyerLanguage String,
    orderStatus OrderStatusEnum,
    confirmationNumber String
}

entity OrderDetail {
	orderNumber String,
    productNumber String,
    quantity Integer,
    unitPrice BigDecimal    
}

entity Product {
	productNumber String,    
    unitPrice BigDecimal,
    nameFr String,
    nameEn String,
    descriptionFr String,
    descriptionEn String,
    weight String,
    categoryFr String,
    categoryEn String
}

entity Category {
	number Long,
    descriptionFr String,
    descriptionEn String
}

relationship OneToOne {
	Seller{me} to WebUser,
    Seller{buyer} to WebUser,
    OrderDetail{product} to Product
}

relationship ManyToMany {
	WebUser{Role(name)} to Role{webUser}
}

relationship OneToMany {
	Campaign to Group{campaign},
	Group to Seller{group},
    Seller to OrderHeader{seller},
    OrderHeader to OrderDetail{header}    
}

relationship ManyToOne {
	Product to Category
}

// Use Data Transfer Objects (DTO)
dto * with mapstruct

// Set service options to all except few
service all with serviceImpl except Role
