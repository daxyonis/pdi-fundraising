
/**
* Campaign entity
* @author Eva Maciejko
*/
entity PdiCampaign {
	number Long,
	organizationNum Long,
    organizationName String,
    project String,
    leaderNum String,
    leaderEmail String,
    dueDate LocalDate,
    orderTypeNum Integer,
    blocked Boolean,
    closed Boolean,
    blockedDate LocalDate,
    closedDate LocalDate
}

/**
* Group entity
* @author Eva Maciejko
*/
entity PdiGroup {
	number Long,
    name String,
    leaderNum String
}

/**
* Seller entity
* @author Eva Maciejko
*/
entity PdiSeller {
	number Long,
    name String    
}

enum OrderStatusEnum {
	PAID,
    ERROR
}

entity OrderHeader {
	orderNumber String,
    buyerName String,
    buyerPhone String,
    buyerNote String,
    buyerLanguage String,
    orderStatus OrderStatusEnum,
    confirmationNumber String
}

entity OrderItem {
	orderNumber String,
    productNumber String,
    quantity Integer,
    unitPrice BigDecimal    
}

entity PdiProduct {
	productNumber String,        
    nameFr String,
    nameEn String,
    descriptionFr String,
    descriptionEn String,
    weight String    
}

entity PdiCategory {
	number Long,
    descriptionFr String,
    descriptionEn String,
    unitPrice BigDecimal
}

entity OrderType {
	number Long    
}

relationship OneToOne {
	PdiSeller{me} to User,
    PdiSeller{buyer} to User,
    OrderItem{pdiProduct} to PdiProduct
}

relationship ManyToMany {	
    OrderType{pdiProducts required} to PdiProduct{orderTypes}
}

relationship OneToMany {
	PdiCampaign to PdiGroup{pdiCampaign},
	PdiGroup to PdiSeller{pdiGroup},
    PdiSeller to OrderHeader{pdiSeller},
    OrderHeader to OrderItem{header},
    PdiCategory to PdiProduct{pdiCategory},    
    OrderType to PdiCampaign{orderType}
}

// Use Data Transfer Objects (DTO)
dto * with mapstruct

// Set service options to all
service all with serviceImpl
